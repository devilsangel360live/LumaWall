# LumaWall Docker Environment Configuration
# Copy this file to .env and fill in your values

# ===== Frontend Configuration =====
# MapTiler API Key for weather maps
# Get your free key from: https://cloud.maptiler.com
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# API URL - Leave empty for Docker (uses nginx proxy)
# For local dev, set to http://localhost:3001
VITE_API_URL=

# ===== Backend Configuration =====
# Google Calendar API Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redirect URI - Use your NAS IP address or hostname
# IMPORTANT: This MUST be added to Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# See GOOGLE_OAUTH_FIX.md for detailed instructions
# Examples:
#   http://192.168.1.203:3001/api/calendar/auth/callback (IP address)
#   http://omv6.local:3001/api/calendar/auth/callback (hostname)
GOOGLE_REDIRECT_URI=http://YOUR_NAS_IP:3001/api/calendar/auth/callback

# Calendar Sync Configuration
# How often to sync with Google Calendar (in minutes)
# Recommended: 15 (every 15 minutes)
# Fast: 5 (every 5 minutes)
# Slow: 30 (every 30 minutes)
SYNC_INTERVAL=15

# ===== Entertainment Panel Configuration =====
# TMDB API for movie listings
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# AstronomyAPI for star charts
# Get credentials from: https://astronomyapi.com
ASTRONOMY_APP_ID=your_astronomy_app_id_here
ASTRONOMY_APP_SECRET=your_astronomy_app_secret_here

# Location for star chart (your NAS location)
# Get coordinates from: https://www.latlong.net/
LOCATION_LATITUDE=40.7128
LOCATION_LONGITUDE=-74.0060

# ===== Notes =====
# - This file should be in the same directory as docker-compose.yml
# - Google Calendar API is FREE with 1 million requests/day
# - Even 1-minute sync uses only 0.58% of daily quota
# - See GOOGLE_API_LIMITS.md for details
